modules = ["python-3.12"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "BrandonBot Server"

[[workflows.workflow]]
name = "BrandonBot Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && python3.12 -m uvicorn main:app --host 0.0.0.0 --port 5000 --timeout-keep-alive 300"
waitForPort = 5000

[nix]
channel = "stable-25_05"
packages = ["c-ares", "cargo", "csvkit", "emacs", "gcc-unwrapped", "grpc", "libiconv", "libxcrypt", "oneDNN", "openssh", "openssl", "pkg-config", "python312Packages.uvicorn", "re2", "rustc", "sqlite-interactive", "xcodebuild", "zlib"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6060
externalPort = 8000

[userenv]

[userenv.shared]
OMP_NUM_THREADS = "4"
ORT_INTRA_OP_NUM_THREADS = "4"
ORT_INTER_OP_NUM_THREADS = "1"
LLM_PROVIDER = "gemini"
DEPLOYMENT_MODE = "replit"
ARCHITECTURE_MODE = "llm_first"
SENDGRID_FROM_EMAIL = "jdstrayer@netzero.net"

[userenv.development]
TESTING_MODE = "true"
